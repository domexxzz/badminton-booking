# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this app, used in magic-link emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where customers transfer money: 10-digit mobile, 13-digit national/tax ID, or 15-digit e-wallet ID
PROMPTPAY_ID=0812345678

# ---- Automatic slip verification (optional; without these, an admin reviews every slip) ----
# Server-only. Supabase Settings -> API -> service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# https://developer.easyslip.com -> API key
EASYSLIP_API_KEY=
# Required for auto-confirm: receiver name as printed on slips (Thai and/or English, comma-separated).
SLIP_RECEIVER_NAME=สมชาย ใจดี,Somchai Jaidee
# Bank account linked to PROMPTPAY_ID. Some bank slips show only the account, not the PromptPay ID.
SLIP_RECEIVER_BANK_ACCOUNT=123-4-56789-0

# ---- Confirm payments from the shop phone's bank notifications (MacroDroid) ----
# Random secret, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anyone with this secret can confirm bookings: keep it only on the server and the shop phone.
BANK_WEBHOOK_SECRET=
# Package names of the bank apps on the shop phone (comma-separated). Only these apps count.
# e.g. K PLUS = com.kasikorn.retail.mbanking.wap, SCB EASY = com.scb.phone (check the id= in the Play Store URL)
BANK_APP_PACKAGES=

# ---- LINE (optional) ----
# LINE Login channel (LINE Developers Console). Callback URL to register:
#   <NEXT_PUBLIC_SITE_URL>/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# "aggressive" or "normal" to offer adding the shop's LINE OA as a friend at login
# (the OA must be linked to the LINE Login channel). Leave empty if there is no OA.
LINE_LOGIN_BOT_PROMPT=
# Messaging API channel access token of the shop's LINE OA, for notifications to admins.
# The OA's Messaging API channel must be under the same LINE provider as the Login channel.
LINE_MESSAGING_TOKEN=
# Which events to push to admins: confirmed, needs_review, unmatched
LINE_NOTIFY_EVENTS=confirmed,needs_review,unmatched
# ocr
TYPHOON_API_KEY=
